<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SteamSdkDir Condition="'$(SteamSdkDir)' == ''">D:/SteamLibrary/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64</SteamSdkDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET" HintPath="$(SteamSdkDir)/Steamworks.NET.dll" Private="true" />
    <None Include="$(SteamSdkDir)/steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="ToolDirectory" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>
</Project>
